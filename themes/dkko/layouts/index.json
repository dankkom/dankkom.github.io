[
  {{- range $index, $page := where site.RegularPages "Section" "posts" -}}
  {{- if $index -}},{{- end -}}
  {
    "title": {{ $page.Title | jsonify }},
    "permalink": {{ $page.Permalink | jsonify }},
    "summary": {{ $page.Summary | plainify | truncate 200 | jsonify }},
    "tags": [{{ range $tindex, $tag := $page.Params.tags }}{{ if $tindex }},{{ end }}{{ $tag | jsonify }}{{ end }}],
    "date": {{ $page.Date.Format "02 Jan 2006" | jsonify }}
  }
  {{- end -}}
]
